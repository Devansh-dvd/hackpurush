# .env.local.example — TEMPLATE for IRONCLAD browser key config
# ---------------------------------------------------------------
# Copy this file to .env.local and paste the hex key from gen_key.py
#
#   cp .env.local.example .env.local
#   python scripts/gen_key.py    ← prints "Key hex: <32 chars>"
#   Then paste the hex string below.
#
# .env.local is gitignored. Never commit it.

# AES-128-GCM pre-shared key — 32 hex characters = 16 bytes
# Must exactly match the bytes in firmware/secrets.h
VITE_IRONCLAD_PSK=00000000000000000000000000000000
